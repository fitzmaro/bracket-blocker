# Ball Don't Lie API
# Sign up at https://www.balldontlie.io/ to get your API key
BALLDONTLIE_API_KEY=your_api_key_here

# Resend (for transactional emails)
# Sign up at https://resend.com
RESEND_API_KEY=your_resend_key_here

# Admin secret for protected endpoints (generate a random string)
ADMIN_SECRET=your_random_secret_here

# Vercel KV (auto-added when you connect KV storage in Vercel dashboard)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
